# Persistent Node API host (for example, a Render Web Service), NOT a Vercel static build.
# This is a deployment subset. Optional provider keys are listed in server/.env.example.
# Replace URLs and MongoDB connection details. Generate JWT_SECRET yourself.
NODE_ENV=production
MONGO_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/agrilink?retryWrites=true&w=majority
JWT_SECRET=
SEED_ON_START=false
# Existing login and demo operations accounts are for a controlled demo, not production authentication.
DEV_OTP=1234
USD_INR=88
PUBLIC_APP_URL=https://YOUR-APP.vercel.app
PUBLIC_API_URL=https://YOUR-API.onrender.com
# Private Python service hostnames from your hosting dashboard, same private network/region.
ML_URL=http://YOUR-ML-PRIVATE-HOST:10000
M2_API_URL=http://YOUR-M2-PRIVATE-HOST:10000/api/m2
M2_DB_NAME=agrilink_m2
ASSISTANT_MODE=basic
MESSAGING_MODE=simulated
CHAIN_ENABLED=false
# Attach an actual persistent disk at /var/data before using these paths.
DOC_STORE_DIR=/var/data/agreements
CERT_STORE_DIR=/var/data/certificates
STAGE_PHOTO_DIR=/var/data/stage-photos
ADVISORY_EVIDENCE_DIR=/var/data/advisory-evidence
# PORT is supplied by the host; do not copy your local port into frontend URLs.

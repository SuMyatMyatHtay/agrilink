# Private Module 2 Python backend. Use the SAME Atlas cluster as Node.
M2_MONGO_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
M2_DB_NAME=agrilink_m2
M2_CV_URL=http://YOUR-ML-PRIVATE-HOST:10000
M2_PUBLIC_TRACE_BASE=https://YOUR-APP.vercel.app/m2/trace
M2_CORS_ORIGINS=https://YOUR-APP.vercel.app
# Attach a persistent disk at /var/data on this service too (separate from Node's disk).
M2_UPLOAD_DIR=/var/data/uploads
M2_MAX_UPLOAD_MB=8
M2_ALLOW_DEMO_CONTROLS=false
M2_PILOT_START=2026-11-01
# Other M2_* defaults remain in module2/backend/.env.example.

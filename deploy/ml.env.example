# Vercel FastAPI ML project. No database/JWT/Telegram keys are needed for sample models.
DATA_GOV_IN_API_KEY=
VISION_GALLERY_DIR=
# .python-version selects Python 3.12. Build command: python scripts/prepare_models.py
# Enable large Python bundles if supported by your Vercel project/account.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
# Farm operations is bundled into this same deployment. Copy the same Atlas URI
# used by Node into M2_MONGO_URI; select a separate database name below.
M2_MONGO_URI=
M2_DB_NAME=agrilink_m2
# Same random secret as M2_GATEWAY_SECRET on the Node project.
M2_GATEWAY_SECRET=
M2_PHOTO_STORE=mongodb
M2_ALLOW_DEMO_CONTROLS=false
M2_CV_URL=
M2_PUBLIC_TRACE_BASE=https://YOUR-FRONTEND.vercel.app/trace

# ADMIN IS PART OF THE EXISTING CLIENT. No separate admin environment is normally needed.
# Use client.env.example for the shared deployment; open /login/operations then /ops/decisions.
# Optional ONLY: if you want a second admin hostname, deploy the SAME agrilink/client
# build as a second Vercel project with these same values. No separate admin source exists.
# That second hostname still serves the full app; it is not an access-control boundary.
API_URL=https://YOUR-API.onrender.com
VITE_REALTIME_URL=https://YOUR-API.onrender.com
# Keep the backend URL shared; do not create another database or JWT_SECRET for admin.

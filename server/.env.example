# REQUIRED for Atlas: Connect > Drivers URI, include /agrilink before the ?.
# Replace user/password/cluster; URL-encode special password characters.
MONGO_URI=mongodb://127.0.0.1:27017/agrilink
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/agrilink?retryWrites=true&w=majority
# FCFS claims use transactions: Atlas or a local replica set is required (not standalone MongoDB).
JWT_SECRET=
PORT=4000
NODE_ENV=development
# Hosted setup: NODE_ENV=production, strong JWT_SECRET, Atlas MONGO_URI.
# Set environment variables on the backend host, not in the Vercel frontend.
# Build/install: npm ci --omit=dev. Start: npm start. No output directory.
# Keep one API instance while Socket.IO broadcasting and jobs are in-process.
SEED_ON_START=false
USD_INR=88
# Existing auth is DEMO ONLY: shared OTP; SMS verification is not implemented.
DEV_OTP=1234
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Hosted URLs in deployment, never localhost. Private-network HTTP is also valid.
ML_URL=http://127.0.0.1:8000
M2_API_URL=http://127.0.0.1:8100/api/m2
# Module 2 must use the SAME Atlas cluster: Node also reads its database directly.
M2_DB_NAME=agrilink_m2

# Optional assistant: basic needs no key.
ASSISTANT_MODE=basic
ASSISTANT_PROVIDER=anthropic
ASSISTANT_API_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_BASE_URL=
# Set a real model ID available in your account when enabling AI.
ASSISTANT_MODEL=

# Optional Meta WhatsApp Business Cloud API. Simulated sends are not deliveries.
MESSAGING_MODE=simulated
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_PREFIX=agrilink_
# Approve agrilink_new_requirement in English for new-request alerts.
# Parameters: buyer, grade, tons, USD price/kg, app link. Simulated mode sends nothing.

# Optional SMS: msg91, twilio, or http. This does NOT implement login OTP.
SMS_PROVIDER=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_IDS={}
SMS_WEBHOOK_TOKEN=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# Optional WhatsApp voice replies; browser STT/TTS use Web Speech APIs, no keys.
TTS_PROVIDER=
GOOGLE_TTS_API_KEY=
# Telegram and uploaded-audio STT are NOT implemented; no working keys to configure.

# Optional blockchain: deployment JSON + artifacts currently required.
CHAIN_ENABLED=false
# Blank values use LOCAL Hardhat defaults; do not fund the development wallet.
CHAIN_RPC=
CHAIN_PRIVATE_KEY=
CHAIN_DEPLOYMENT=

# Persistent backend paths. Blank locally uses module defaults. Never Vercel /tmp.
DOC_STORE_DIR=
CERT_STORE_DIR=
STAGE_PHOTO_DIR=
ADVISORY_EVIDENCE_DIR=
# S3 / Zoho Sign / DocuSign adapters are stubs; keys alone cannot enable them.
# Production examples for a persistent disk mounted at /var/data:
# DOC_STORE_DIR=/var/data/agreements
# CERT_STORE_DIR=/var/data/certificates
# STAGE_PHOTO_DIR=/var/data/stage-photos
# ADVISORY_EVIDENCE_DIR=/var/data/advisory-evidence
# Full deployment templates, including optional admin hostname: ../deploy/*.env.example

MONGO_URI=
CHAIN_ENABLED=

TELEGRAM_ENABLED=
TELEGRAM_MODE=
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME_WITHOUT_AT
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_SECRET
MESSAGING_CHANNELS=

DEV_OTP=
PUBLIC_APP_URL=
PUBLIC_API_URL=
# Agreement PDFs automatically use MongoDB on Vercel; no additional credentials.
# Set DOC_STORE_BACKEND=mongodb to use the same durable storage locally.
DOC_STORE_BACKEND=
# Hosted blockchain: use a dedicated test-only wallet, never the Hardhat dev key.
CHAIN_RPC=
CHAIN_PRIVATE_KEY=
CHAIN_CONTRACT_ADDRESS=
CHAIN_ID=80002
# Optional hosted voice transcription for Telegram and recorded web voice notes.
# Create a Groq API key at console.groq.com/keys. Never expose it in VITE_*.
SPEECH_API_KEY=
SPEECH_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
SPEECH_MODEL=whisper-large-v3-turbo
# Demo recording loads labelled editable placeholder text without an API key.
# Change to live after adding a real speech provider key.
SPEECH_MODE=demo
SPEECH_DEMO_TEXT=When should I water my crop?
# Bundled farm operations: hosted default derives from ML_URL. Override only if
# deploying farm operations separately. Local one-command launcher sets this.
M2_API_URL=
M2_DB_NAME=agrilink_m2
# Shared with the Python/ML deployment; generate locally, not from a provider.
M2_GATEWAY_SECRET=

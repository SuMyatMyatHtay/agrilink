# Same Atlas cluster as Node MONGO_URI; database selected separately.
# Deploy as a PRIVATE Python service behind the Node gateway, not a public admin API.
# Build: python -m pip install -r requirements.txt
# Start: python -m uvicorn app.main:app --host 0.0.0.0 --port 10000
# Health: /api/m2/health. No static output directory.
M2_MONGO_URI=mongodb://127.0.0.1:27017
M2_DB_NAME=agrilink_m2
M2_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
M2_CV_URL=http://127.0.0.1:8000
M2_PUBLIC_TRACE_BASE=http://localhost:5173/m2/trace
# Hosted: https://your-app.vercel.app/m2/trace
# Persistent disk; omit to use local uploads/ default.
# M2_UPLOAD_DIR=/data/uploads
# On a backend with a persistent disk mounted at /var/data: M2_UPLOAD_DIR=/var/data/uploads
M2_MAX_UPLOAD_MB=8
M2_ALLOW_DEMO_CONTROLS=false
M2_PILOT_START=2026-11-01
M2_DISPUTE_WINDOW_HOURS=72
M2_FUNDING_DUE_HOURS=24
M2_CHECK_INTERVAL_DAYS=7
M2_UPLOAD_GRACE_HOURS=48
M2_CV_VALID_DAYS=10
M2_FINDING_VALID_DAYS=14
M2_SUPPLY_RISK_THRESHOLD=0.95
M2_RESERVE_NEW_SHARE=0.20
# Required for any public deployment; set the same secret on the Node gateway.
M2_GATEWAY_SECRET=
# Automatic on Vercel. Also usable locally for durable Atlas photo storage.
M2_PHOTO_STORE=mongodb

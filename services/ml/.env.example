# Optional live Agmarknet prices from data.gov.in; sample models need no key.
DATA_GOV_IN_API_KEY=
# Optional vision gallery folder.
VISION_GALLERY_DIR=
# Vercel: root agrilink/services/ml; FastAPI / Python 3.12; auto-install requirements.txt.
# Build: python scripts/prepare_models.py. No output directory or production start command.
# Entry app/main.py:app. Health: /health. API docs: /docs.
# Build prepares forecasting artifacts; Vercel runtime loads them without training/writing.
# Vision gallery updates are disabled on Vercel; inference remains available.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
# Forecast-only endpoints need no database. Bundled farm operations needs these:
M2_MONGO_URI=
M2_DB_NAME=agrilink_m2
M2_GATEWAY_SECRET=
M2_PHOTO_STORE=mongodb
M2_ALLOW_DEMO_CONTROLS=false
# Leave blank to use the ML vision code in-process; no extra AI provider needed.
M2_CV_URL=
M2_PUBLIC_TRACE_BASE=http://localhost:5173/trace
# No Node JWT_SECRET is needed here; the Node gateway authenticates users.
# It also needs no Telegram token; Telegram runs in the Node backend.

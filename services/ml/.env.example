# Optional live Agmarknet prices from data.gov.in; sample models need no key.
DATA_GOV_IN_API_KEY=
# Optional vision gallery folder.
VISION_GALLERY_DIR=
# Deploy as a private Python service called by Node and Module 2.
# Build: python -m pip install -r requirements.txt
# Start: python -m uvicorn app.main:app --host 0.0.0.0 --port 10000
# Health: /health. No static output directory.
# Startup loads/trains model artifacts; allow startup time and writable models/ directory.
# This service needs neither MONGO_URI nor JWT_SECRET.
